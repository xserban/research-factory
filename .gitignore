# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Factory: rebuildable index; project-local literature library (decision 39)
projects/*/.index/
projects/*/library/
# Factory: ephemeral progress of long operations (slice 8, IDEA-44), never an event
projects/*/.progress/
# Factory: derived, rebuildable lead engine cache (never an event)
projects/*/cache/
projects/*/blobs/**/*.pdf
# Factory: the rebuildable shared mining store (slice M ruling 18)
/.mining/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Claude Code: personal settings stay local; shared project settings are committed
.claude/settings.local.json

# Experiments: raw literature and outputs never enter git (decision 39)
experiments/*/data/
experiments/*/tools/
.claude/worktrees/

# Local scratch, never committed
tmp/
/data/
